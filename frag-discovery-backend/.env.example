# Google OAuth — Client ID of your OAuth 2.0 "Web application" credential
# (Google Cloud Console → Credentials → Create OAuth client ID).
# Same ID will be used by the frontend "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# SQLAlchemy database URL. SQLite is the default; swap to Postgres later by
# changing this one line (e.g. postgresql+psycopg://user:pass@host:5432/frag).
DATABASE_URL=sqlite:///./data/app.db

# Read-only fragrance catalog DB (the recommender feature matrix + browse/
# detail reads). Dev: symlinked from frag-scraper via `make sync-catalog`
# (default). Deploy: copy the DB here or point this at a mounted copy.
# Only frags with >= 20 votes and a >= 3.8 Bayesian rating are recommendable.
CATALOG_DB=data/fragrances.db

# Allowed CORS origin for the frontend (dev: Vite on 5173).
FRONTEND_ORIGIN=http://localhost:5173

# How long an issued session lives, in days.
SESSION_TTL_DAYS=30

# development | production
ENV=development
